<?xml version="1.0" encoding="UTF-16"?>
<!--
  Hermes Voicebox GPU lifecycle - Windows Scheduled Task.

  Windows analogue of installer/systemd/voicebox-gpu-lifecycle.service.
  Keep both files in sync when changing lifecycle behaviour:

    systemd                        =>  Scheduled Task
    WantedBy=default.target        =>  LogonTrigger (runs at user logon)
    Restart=on-failure             =>  RestartOnFailure interval/count
    RestartSec=5                   =>  Interval PT1M (scheduler minimum)
    Type=simple                    =>  Exec action, no exit expected
    TimeoutStopSec=10              =>  ExecutionTimeLimit PT0S (unbounded;
                                       the daemon self-terminates)
    KillSignal=SIGTERM             =>  terminate maps to CTRL_BREAK / SIGBREAK,
                                       handled by voicebox_gpu.py

  The ExecStart equivalent (Command/Arguments below) is rewritten at install
  time by install._install_gpu_lifecycle_schtasks() with absolute interpreter
  and script paths. Placeholders are replaced verbatim; do not reformat them.

  Control API stays on localhost only (127.0.0.1:17494); this task does not
  expose Voicebox beyond its existing bind.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Hermes Voicebox GPU lifecycle (idle unload + stop on Hermes exit)</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__VOICEBOX_GPU_USERID__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__VOICEBOX_GPU_COMMAND__</Command>
      <Arguments>__VOICEBOX_GPU_ARGUMENTS__</Arguments>
    </Exec>
  </Actions>
</Task>
